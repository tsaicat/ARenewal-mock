{
  "info": {
    "name": "Mock Renewal Email API \u2014 v0.4 Lifecycle Truthfulness",
    "description": "Manual QA collection for Mock Auto-Renewal Email API v0.4. Covers JSON + multipart sending, asynchronous provider delivery evidence, offer lineage, response provenance/history, semantic milestone idempotency, controlled resend, and response acknowledgments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "offerNumber",
      "value": "ARN-OFFER-HO2027100022-00-HO2027100022-01"
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "replyId",
      "value": ""
    },
    {
      "key": "formsPackageId",
      "value": "ARN-FORMS-ARN-POSTMAN-1001"
    },
    {
      "key": "formsPackageSnapshotId",
      "value": "ARN-POSTMAN-1001:auto-renewal-forms:POSTMAN-S1"
    },
    {
      "key": "baseOfferNumber",
      "value": "ARN-POSTMAN-1001"
    },
    {
      "key": "responseEventId",
      "value": ""
    },
    {
      "key": "originalMessageId",
      "value": ""
    },
    {
      "key": "acceptanceResponseEventId",
      "value": ""
    },
    {
      "key": "declineResponseEventId",
      "value": ""
    },
    {
      "key": "lateMessageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Send renewal offer email (60-day, generation notice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('messageId', body.messageId);",
              "pm.environment.set('originalMessageId', body.messageId);",
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('milestone is 60', () => pm.expect(body.milestone).to.eql(60));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-PAS-Integration-Namespace",
            "value": "AR_EMAIL",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"EMAIL-REQ-{{$guid}}\",\n  \"messageType\": \"AUTO_RENEWAL_OFFER\",\n  \"offerNumber\": \"{{offerNumber}}\",\n  \"sourcePolicyId\": \"HO2027100022-00\",\n  \"resultingPolicyId\": \"HO2027100022-01\",\n  \"customerRef\": \"922-FL-DEMO00022\",\n  \"recipient\": {\n    \"name\": \"Victor Sterling\",\n    \"email\": \"victor.sterling@example.test\"\n  },\n  \"offer\": {\n    \"offeredPremium\": 3384,\n    \"premiumChangeAmount\": 0,\n    \"premiumChangePercent\": 0,\n    \"renewalEffectiveDate\": \"2026-08-16\",\n    \"responseDueDate\": \"2026-08-01\",\n    \"noticeMilestone\": 60\n  },\n  \"responseInstructions\": {\n    \"acceptKeywords\": [\n      \"ACCEPT\",\n      \"YES RENEW\",\n      \"CONFIRM RENEWAL\"\n    ],\n    \"declineKeywords\": [\n      \"DECLINE\",\n      \"DO NOT RENEW\",\n      \"REJECT RENEWAL\"\n    ],\n    \"responseToken\": \"SIGNED-ONE-TIME-TOKEN\"\n  },\n  \"sentBy\": {\n    \"actor\": \"Auto-Renewal Batch\",\n    \"role\": \"System\"\n  },\n  \"integrationNamespace\": \"AR_EMAIL\",\n  \"baseOfferNumber\": \"{{baseOfferNumber}}\",\n  \"offerVersion\": 1,\n  \"communicationType\": \"NOTICE\"\n}"
        }
      }
    },
    {
      "name": "1b. Re-send same requestId (idempotency check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('duplicate flag set, same messageId returned', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.duplicate).to.eql(true);",
              "  pm.expect(body.messageId).to.eql(pm.environment.get('messageId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-PAS-Integration-Namespace",
            "value": "AR_EMAIL",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails",
        "description": "Run request #1 first, copy its requestId here manually (Postman variables don't survive verbatim across a raw body) to confirm the second send is deduped and returns the original message.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"PASTE-SAME-requestId-FROM-REQUEST-1-HERE\",\n  \"offerNumber\": \"{{offerNumber}}\",\n  \"sourcePolicyId\": \"HO2027100022-00\",\n  \"recipient\": {\n    \"name\": \"Victor Sterling\",\n    \"email\": \"victor.sterling@example.test\"\n  },\n  \"messageType\": \"AUTO_RENEWAL_OFFER\",\n  \"integrationNamespace\": \"AR_EMAIL\",\n  \"customerRef\": \"922-FL-DEMO00022\",\n  \"baseOfferNumber\": \"{{baseOfferNumber}}\",\n  \"offerVersion\": 1,\n  \"communicationType\": \"NOTICE\"\n}"
        }
      }
    },
    {
      "name": "2. Send renewal notice email (45-day)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-PAS-Integration-Namespace",
            "value": "AR_EMAIL",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"EMAIL-REQ-{{$guid}}\",\n  \"offerNumber\": \"{{offerNumber}}\",\n  \"sourcePolicyId\": \"HO2027100022-00\",\n  \"resultingPolicyId\": \"HO2027100022-01\",\n  \"customerRef\": \"922-FL-DEMO00022\",\n  \"recipient\": {\n    \"name\": \"Victor Sterling\",\n    \"email\": \"victor.sterling@example.test\"\n  },\n  \"offer\": {\n    \"offeredPremium\": 3384,\n    \"premiumChangeAmount\": 120,\n    \"premiumChangePercent\": 3.7,\n    \"renewalEffectiveDate\": \"2026-08-16\",\n    \"responseDueDate\": \"2026-08-01\",\n    \"noticeMilestone\": 45\n  },\n  \"messageType\": \"AUTO_RENEWAL_OFFER\",\n  \"integrationNamespace\": \"AR_EMAIL\",\n  \"baseOfferNumber\": \"{{baseOfferNumber}}\",\n  \"offerVersion\": 1,\n  \"communicationType\": \"NOTICE\"\n}"
        }
      }
    },
    {
      "name": "3. Send final notice email (15-day, response required)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-PAS-Integration-Namespace",
            "value": "AR_EMAIL",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"EMAIL-REQ-{{$guid}}\",\n  \"offerNumber\": \"{{offerNumber}}\",\n  \"sourcePolicyId\": \"HO2027100022-00\",\n  \"resultingPolicyId\": \"HO2027100022-01\",\n  \"customerRef\": \"922-FL-DEMO00022\",\n  \"recipient\": {\n    \"name\": \"Victor Sterling\",\n    \"email\": \"victor.sterling@example.test\"\n  },\n  \"offer\": {\n    \"offeredPremium\": 3384,\n    \"renewalEffectiveDate\": \"2026-08-16\",\n    \"responseDueDate\": \"2026-08-01\",\n    \"noticeMilestone\": 15\n  },\n  \"messageType\": \"AUTO_RENEWAL_OFFER\",\n  \"integrationNamespace\": \"AR_EMAIL\",\n  \"baseOfferNumber\": \"{{baseOfferNumber}}\",\n  \"offerVersion\": 1,\n  \"communicationType\": \"NOTICE\"\n}"
        }
      }
    },
    {
      "name": "4A. Send renewal email WITH actual Forms PDF",
      "description": "Multipart contract. In Postman, if the bundled relative fixture is not automatically resolved, choose postman/fixtures/renewal-forms-sample.pdf in the attachments file field.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('formsMessageId', body.messageId);",
              "pm.environment.set('attachmentId', body.formsDelivery?.attachmentIds?.[0] || '');",
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('email sent', () => pm.expect(body.emailDeliveryStatus).to.eql('SENT'));",
              "pm.test('forms delivered', () => pm.expect(body.formsDelivery.status).to.eql('DELIVERED'));",
              "pm.test('actual attachment correlated', () => pm.expect(body.formsDelivery.attachmentCount).to.eql(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-PAS-Integration-Namespace",
            "value": "AR_EMAIL",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "metadata",
              "value": "{\"requestId\": \"AR-EMAIL-REQ-POSTMAN-FORMS-{{$guid}}\", \"messageType\": \"AUTO_RENEWAL_OFFER\", \"integrationNamespace\": \"AR_EMAIL\", \"offerNumber\": \"ARN-POSTMAN-1001\", \"sourcePolicyId\": \"PA2027000001-00\", \"customerRef\": \"CUST-POSTMAN-1001\", \"recipient\": {\"name\": \"QA Customer\", \"email\": \"qa.customer@example.test\"}, \"noticeMilestone\": \"60_DAY\", \"formsPackageId\": \"{{formsPackageId}}\", \"formsPackageSnapshotId\": \"{{formsPackageSnapshotId}}\", \"offer\": {\"offeredPremium\": 1200, \"premiumChangeAmount\": 50, \"premiumChangePercent\": 4.35, \"renewalEffectiveDate\": \"2026-10-01\", \"responseDueDate\": \"2026-09-16\", \"noticeMilestone\": 60}, \"responseInstructions\": {\"acceptKeywords\": [\"ACCEPT\", \"YES RENEW\", \"CONFIRM RENEWAL\"], \"declineKeywords\": [\"DECLINE\", \"DO NOT RENEW\", \"REJECT RENEWAL\"], \"responseToken\": \"AR-EMAIL-TOKEN-POSTMAN-FORMS\"}, \"sentBy\": {\"actor\": \"Auto-Renewal Batch\", \"role\": \"System\"}, \"baseOfferNumber\": \"{{baseOfferNumber}}\", \"offerVersion\": 1, \"communicationType\": \"FORMS\"}",
              "type": "text"
            },
            {
              "key": "attachments",
              "type": "file",
              "src": "postman/fixtures/renewal-forms-sample.pdf"
            }
          ]
        }
      }
    },
    {
      "name": "4. Privacy exclusion check (SSN/DOB/payment sent but must be stripped)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('accepted (201) despite disallowed fields present', () => pm.response.to.have.status(201));",
              "pm.test('response body does not echo ssn/dob', () => {",
              "  const raw = pm.response.text();",
              "  pm.expect(raw).to.not.include('123-45-6789');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-PAS-Integration-Namespace",
            "value": "AR_EMAIL",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"EMAIL-REQ-{{$guid}}\",\n  \"offerNumber\": \"{{offerNumber}}\",\n  \"sourcePolicyId\": \"HO2027100022-00\",\n  \"recipient\": {\n    \"name\": \"Victor Sterling\",\n    \"email\": \"victor.sterling@example.test\"\n  },\n  \"customer\": {\n    \"ssn\": \"123-45-6789\",\n    \"dateOfBirth\": \"1980-01-01\",\n    \"paymentAccount\": \"XXXX-4242\"\n  },\n  \"offer\": {\n    \"offeredPremium\": 3384\n  },\n  \"messageType\": \"AUTO_RENEWAL_OFFER\",\n  \"integrationNamespace\": \"AR_EMAIL\",\n  \"customerRef\": \"922-FL-DEMO00022\",\n  \"baseOfferNumber\": \"{{baseOfferNumber}}\",\n  \"offerVersion\": 1,\n  \"communicationType\": \"NOTICE\"\n}"
        }
      }
    },
    {
      "name": "5. List sent messages (inbox)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/renewal-emails"
      }
    },
    {
      "name": "6. Get single message detail (replies + offer state)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/messages/{{messageId}}"
      }
    },
    {
      "name": "6A. View/download Forms attachment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/messages/{{formsMessageId}}/attachments/{{attachmentId}}?download=1"
      }
    },
    {
      "name": "7. Simulate reply \u2014 ACCEPT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('classified ACCEPT', () => {",
              "  const body = pm.response.json();",
              "  pm.environment.set('acceptanceResponseEventId', body.eventId);",
              "  pm.expect(body.classification).to.eql('ACCEPT');",
              "  pm.expect(body.callbackStatus).to.eql('APPLIED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails/{{messageId}}/replies",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": \"victor.sterling@example.test\",\n  \"plainText\": \"Yes, please renew my policy. I accept the offer.\"\n}"
        }
      }
    },
    {
      "name": "7b. Re-submit same reply (idempotency check)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/renewal-emails/{{messageId}}/replies",
        "description": "Same body/messageId as #7 \u2014 since no replyId was supplied in #7, the server generated one; this second call generates a *new* replyId and will process as a second, distinct reply. To test true replyId-based dedupe, pass an explicit \"replyId\" in the body and repeat it here verbatim.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"replyId\": \"REPLY-IDEMPOTENCY-TEST-001\",\n  \"from\": \"victor.sterling@example.test\",\n  \"plainText\": \"Yes, please renew my policy. I accept the offer.\"\n}"
        }
      }
    },
