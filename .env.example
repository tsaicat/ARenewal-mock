# MOCK-AR-API v0.4.0

# --- Resend outbound + inbound receiving ---
RESEND_API_KEY=
RESEND_SENDER=arenewal@iapasapp.com
RESEND_REPLY_DOMAIN=reply.iapasapp.com
RESEND_WEBHOOK_SECRET=

# Explicit local/test simulation only. Without RESEND_API_KEY, outbound email
# fails unless this is true. Production should leave this false/unset.
ALLOW_SIMULATED_EMAIL=false

# --- Persistence ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# v0.4 keeps actual PDF content in the same persistent backend as message data.
# Attachment limits remain: PDF only, max 3 files, 3 MB/file, 3 MB total.
