# MOCK-AR-API v0.5.0 — Security, Retention, and QA Operations Hardening

# Explicit mode: development | test | production
# On Vercel production, production behavior is also inferred from VERCEL_ENV.
MOCK_ENV_MODE=development

# --- PAS-to-Mock service authentication ---
# Required in production. PAS/browser code MUST NOT hard-code or expose this secret.
# A later PAS integration must use a secure server/proxy or short-lived server-mediated credential pattern.
MOCK_API_KEY=
REQUIRE_API_AUTH=false

# --- QA Inbox authentication ---
# Required in production. Password is validated server-side and exchanged for an HttpOnly signed session cookie.
QA_INBOX_PASSWORD=
QA_SESSION_SECRET=
REQUIRE_QA_AUTH=false

# Separate credential for destructive admin purge operations.
MOCK_ADMIN_TOKEN=

# Optional dedicated internal callback secret. Falls back server-side to QA_SESSION_SECRET / MOCK_API_KEY.
MOCK_INTERNAL_CALLBACK_SECRET=

# --- CORS ---
# Comma-separated browser origins allowed to call the API cross-origin.
# Same-origin Mock UI is always allowed. Local development also permits localhost:3000 and localhost:5173.
# Example: https://pas.example.test,https://mock-ar.example.test
ALLOWED_ORIGINS=

# --- Resend outbound + inbound receiving ---
RESEND_API_KEY=
RESEND_SENDER=arenewal@iapasapp.com
RESEND_REPLY_DOMAIN=reply.iapasapp.com
RESEND_WEBHOOK_SECRET=

# Explicit local/test simulation only. Production still fails closed without RESEND_API_KEY.
ALLOW_SIMULATED_EMAIL=false

# Unsigned provider webhook events are accepted ONLY in non-production when explicitly enabled.
ALLOW_UNSIGNED_WEBHOOK_TEST=false

# --- Persistence ---
# Required for production-equivalent persistence.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Retention ---
# Default 30 days. Supported range: 1..3650.
MOCK_DATA_RETENTION_DAYS=30

# Attachment limits remain: application/pdf only, max 3 files,
# 3 MB/file and 3 MB total per request.
