# --- Resend (sending + inbound receiving) ---
# Get this from https://resend.com/api-keys after verifying the
# iapasapp.com sending domain (or a subdomain of it).
# Must be a "Full access" key, not "Sending access" — the inbound
# webhook route calls the Receiving API (resend.emails.receiving.get)
# to fetch reply bodies, and a send-only key will reject that call.
RESEND_API_KEY=

# Sender used for outbound renewal offer/notice emails.
RESEND_SENDER=arenewal@iapasapp.com

# Domain that Resend RECEIVING (inbound replies) is verified on. This is
# a separate Resend capability from sending and Resend recommends a
# dedicated subdomain (e.g. reply.iapasapp.com) rather than the root
# domain, so it doesn't conflict with iapasapp.com's existing MX
# records. If left blank, this defaults to RESEND_SENDER's domain,
# which only works if you've also enabled Receiving there.
RESEND_REPLY_DOMAIN=reply.iapasapp.com

# From Resend Dashboard > Webhooks, after adding a webhook subscribed to
# the `email.received` event pointed at
# https://<your-deployment>/api/webhooks/resend
# Leave blank for local/dev use — the webhook route will accept
# unverified payloads with a console note, but never do this in
# production.
RESEND_WEBHOOK_SECRET=

# --- Persistence (Upstash Redis REST — also what "Vercel KV" uses under
# the hood) ---
# Leave both blank for local development: the app falls back to a JSON
# file at data/db.json. On Vercel, set these or messages/replies will
# not persist across serverless invocations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
